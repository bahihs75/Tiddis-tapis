rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المنتجات: يقرأها الجميع، ويكتبها المستخدمون المصادق عليهم فقط
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الفئات: يقرأها الجميع، ويكتبها المستخدمون المصادق عليهم فقط
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // السمات (Attributes): يقرأها الجميع، ويكتبها المستخدمون المصادق عليهم فقط
    match /attributes/{attributeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // تعريفات تجربة الكتالوج والفلاتر: يقرأها المتجر العام، وتعدلها لوحة الإدارة فقط.
    match /catalogFilters/{filterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الإعدادات العامة للمتجر: يقرأها الجميع، ويكتبها المستخدمون المصادق عليهم فقط
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // أسرار مزودي الصور: لا تُعرض للزوار العامين، وتُتاح حالياً للحسابات المصادق عليها.
    // يمكن تضييقها لاحقاً إلى custom claims مثل role == admin بعد تفعيلها على الخادم.
    match /privateSettings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // الطلبات: السماح لأي زائر بإنشاء طلب، وعدم السماح بالقراءة/التعديل/الحذف إلا للمسجلين
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // فهرس مكتبة الصور: metadata فقط، أما الملفات الفعلية فتظل لدى ImgBB أو المزود الخارجي.
    // لا تُعرض روابط المكتبة أو بيانات الحذف للزوار العامين.
    match /imageLibrary/{imageId} {
      allow read, write: if request.auth != null;
    }

    // سجل تغييرات إداري append-only من واجهة الإدارة.
    match /activityLog/{activityId} {
      allow create, read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
